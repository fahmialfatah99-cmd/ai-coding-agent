# ============================================================================
# AI Coding Agent — Root Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in the API keys you want to use.
# This file is used by docker-compose.yml for the full stack deployment.
# Any field can be left blank — the platform falls back to the next
# available provider. Keys are loaded in priority order per provider.
#
# Security: NEVER commit `.env` (it is in .gitignore). Rotate any key that
#           has ever been pasted into chat, screenshots, or shared logs.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. Database (PostgreSQL with pgvector for semantic memory)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ai_agent_db
POSTGRES_DB=ai_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword


# ---------------------------------------------------------------------------
# 2. Workspace — local folder where the agent reads/writes your project
# ---------------------------------------------------------------------------
WORKSPACE_PATH=./workspace


# ---------------------------------------------------------------------------
# 3. LLM Provider API Keys
#    Each provider is optional and works independently. You can mix and
#    match — e.g. OpenAI for the architect, Anthropic for the builder,
#    Groq for the auditor. Set the ones you have accounts for.
# ---------------------------------------------------------------------------

# --- 9Router (local AI Gateway) -------------------------------------------
# Default: http://127.0.0.1:20128/v1 (auto-detected at runtime)
# Override the base URL only if 9Router runs on a different host/port.
# NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=

# --- OpenAI ---------------------------------------------------------------
# https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4.1, gpt-5, o1, o3, o4-mini, ...
OPENAI_API_KEY=

# --- Google Gemini --------------------------------------------------------
# https://aistudio.google.com/apikey
# Either GEMINI_API_KEY or GOOGLE_API_KEY is accepted.
# Models: gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash, ...
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Anthropic Claude -----------------------------------------------------
# https://console.anthropic.com/settings/keys
# Models: claude-opus-4-1, claude-sonnet-4-5, claude-3-7-sonnet, ...
ANTHROPIC_API_KEY=

# --- Ollama (Local models, no API key required) ---------------------------
# Override the base URL if Ollama is not on the default 127.0.0.1:11434.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=
# Models: llama3.3, qwen2.5-coder, deepseek-r1, mistral, gemma3, ...

# --- Groq (ultra-fast LPU inference) --------------------------------------
# https://console.groq.com/keys
# Models: llama-3.3-70b-versatile, mixtral-8x7b, deepseek-r1-distill, ...
GROQ_API_KEY=

# --- Mistral AI -----------------------------------------------------------
# https://console.mistral.ai/api-keys/
# Models: mistral-large, mistral-medium, codestral, pixtral, ...
MISTRAL_API_KEY=

# --- Cohere ---------------------------------------------------------------
# https://dashboard.cohere.com/api-keys
# Either COHERE_API_KEY or CO_API_KEY is accepted.
# Models: command-r-plus, command-r, aya-expanse-32b, ...
COHERE_API_KEY=
CO_API_KEY=

# --- Together AI ----------------------------------------------------------
# https://api.together.xyz/settings/api-keys
# Models: Llama-3.3-70B, Qwen2.5-Coder, DeepSeek-R1, Mixtral, ...
TOGETHER_API_KEY=

# --- DeepSeek -------------------------------------------------------------
# https://platform.deepseek.com/api_keys
# Models: deepseek-chat (V3), deepseek-reasoner (R1), deepseek-coder
DEEPSEEK_API_KEY=

# --- OpenRouter (100+ models, single key) ---------------------------------
# https://openrouter.ai/keys
# Models: anthropic/*, openai/*, google/*, meta-llama/*, qwen/*, ...
OPENROUTER_API_KEY=
# Optional: identify your app to OpenRouter (recommended)
OPENROUTER_REFERER=https://your-domain.example
OPENROUTER_TITLE=AI Coding Agent


# ---------------------------------------------------------------------------
# 4. Frontend Configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1